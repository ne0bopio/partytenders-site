# Step 2 emails Danielle when a request is saved.
# The public site does not publish an inbox today.
QUOTE_NOTIFY_EMAIL=

# Step 4 takes a deposit when someone books online.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

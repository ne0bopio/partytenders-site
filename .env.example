# PartyTenders — names only. Copy to .env.local when a later step needs them.
# Leave the values empty. Do not commit real keys.

# Step 2 stores quote requests. Step 3 signs Danielle in.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

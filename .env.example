# PartyTenders — names only. Copy to .env.local for local dev.
# Leave the values empty until the project exists. Do not commit real keys.
# The site still runs without these: the quote form falls back to a text message.

# Supabase project URL and the anon key (step 3 uses the anon key for Danielle's login).
# This step inserts with the service role key, on the server only. Never expose it
# as NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Resend. QUOTE_FROM_EMAIL must be a sender on a domain you verify in Resend,
# for example PartyTenders <quotes@partytenderseventparty.com>.
# QUOTE_NOTIFY_EMAIL is Danielle's inbox.
RESEND_API_KEY=
QUOTE_NOTIFY_EMAIL=
QUOTE_FROM_EMAIL=

# Step 4 takes a deposit when someone books online.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
